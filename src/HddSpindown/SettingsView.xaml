<UserControl x:Class="HddSpindown.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HddSpindown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ===== Typography ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- Body text in expanded sections: 14 px, readable line height -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- ===== Cards ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="68" />
        </Style>

        <!-- Icon tile on the left of each card -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <!-- Expandable card like in Windows 11 Settings: header with chevron, content below -->
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Focusable="True" Cursor="Hand" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBg" Background="Transparent" CornerRadius="7" Padding="16,14" MinHeight="68">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                      ContentTemplate="{Binding HeaderTemplate, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                      VerticalAlignment="Center" />
                                                    <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontSize="12" Margin="16,0,4,0"
                                                               FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <TextBlock.RenderTransform>
                                                            <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderBg" Property="CornerRadius" Value="7,7,0,0" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle"
                                                                                 To="180" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ChevronRotate" Storyboard.TargetProperty="Angle"
                                                                                 To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Body" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Padding="20,16,20,18" Visibility="Collapsed">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 style toggle, without On/Off text -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Path display like a read-only text box, long paths truncated with "…" -->
        <Style x:Key="PathBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Content ===== -->

        <!-- Header of an expandable card: icon tile, title, short description -->
        <DataTemplate x:Key="TopicHeader" DataType="{x:Type local:HelpTopic}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                    <TextBlock Style="{StaticResource TileGlyph}" Text="{Binding Glyph}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Summary}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- List item in three variants:
             bullet (dot + bold caption + text), command (field with copy button) and
             state (colored badge like in the main view). -->
        <DataTemplate x:Key="BulletItem" DataType="{x:Type local:HelpItem}">
            <Grid Margin="0,0,0,12">
                <!-- Bullet -->
                <Grid Visibility="{Binding IsBullet, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="5" Height="5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,9,0,0"
                             Fill="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding ShowBulletLabel, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Text}" />
                    </StackPanel>
                </Grid>

                <!-- Command -->
                <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PathBox}">
                            <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="9,6" Tag="{Binding Label}" Click="CopyCommand_Click"
                                ToolTip="{x:Static local:Loc.CopyCommand}" AutomationProperties.Name="{x:Static local:Loc.CopyCommand}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Text}" Margin="2,6,0,0" />
                </StackPanel>

                <!-- State -->
                <Grid Visibility="{Binding IsSwatch, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="10,4" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Swatch}" />
                            <TextBlock Text="{Binding Label}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Text}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Content of an expandable card: intro, list, closing -->
        <DataTemplate x:Key="TopicBody" DataType="{x:Type local:HelpTopic}">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Intro}" Margin="0,0,0,12"
                           Visibility="{Binding HasIntro, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BulletItem}"
                              Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Outro}" Margin="0,2,0,0"
                           Visibility="{Binding HasOutro, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TopicExpander" DataType="{x:Type local:HelpTopic}">
            <Expander Style="{StaticResource SettingsExpander}" Header="{Binding}" HeaderTemplate="{StaticResource TopicHeader}"
                      Content="{Binding}" ContentTemplate="{StaticResource TopicBody}"
                      AutomationProperties.Name="{Binding Title}" />
        </DataTemplate>

        <DataTemplate x:Key="LicenseExpander" DataType="{x:Type local:LicenseEntry}">
            <Expander Style="{StaticResource SettingsExpander}" AutomationProperties.Name="{Binding Name}">
                <Expander.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource TileGlyph}" Text="{Binding Glyph}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource CardDesc}" Text="{Binding Meta}" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Copyright}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Note}" Margin="0,6,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Static local:Loc.LicenseText}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <Border Padding="14,12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- ===== Support ===== -->
        <!-- Yellow "Buy me a coffee" button with a small cup -->
        <Style x:Key="KofiButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFDD63" CornerRadius="20" Padding="14,9,20,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="26" Height="22" Margin="0,0,10,0">
                                    <Canvas Width="26" Height="22">
                                        <Path Data="M2.5,3 H19 V12.5 A6.5,6.5 0 0 1 12.5,19 H9 A6.5,6.5 0 0 1 2.5,12.5 Z"
                                              Fill="White" Stroke="#202020" StrokeThickness="2.2" StrokeLineJoin="Round" />
                                        <Path Data="M19,6 H20.5 A3.6,3.6 0 0 1 20.5,13.2 H19" Stroke="#202020" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M10.8,15 C10.8,15 6.6,12.3 6.6,9.6 A2.2,2.2 0 0 1 10.8,8.8 A2.2,2.2 0 0 1 15,9.6 C15,12.3 10.8,15 10.8,15 Z"
                                              Fill="#FF5E5B" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{x:Static local:Loc.BuyCoffee}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#202020" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE88A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2CD4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text link in the accent color; disabled = placeholder, link coming later -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Navigation ===== -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border CornerRadius="4" BorderThickness="2"
                                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="16,0,12,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItem">
            <StackPanel Orientation="Horizontal" Height="36" ToolTip="{Binding Label}" Background="Transparent">
                <Grid Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="18"
                               Foreground="{Binding Color}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}" />
                    <!-- Support: small animated cup instead of an icon -->
                    <local:CoffeeCup Visibility="{Binding Animated, Converter={StaticResource BoolToVis}}" Margin="-1,-3,-1,0" />
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <!-- Compact navigation (narrow window): icons only -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=local:SettingsView}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left column: back + navigation -->
        <DockPanel Margin="8,8,8,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource BackButton}" Click="Back_Click"
                        ToolTip="{x:Static local:Loc.Back}" AutomationProperties.Name="{x:Static local:Loc.Back}" />
                <TextBlock x:Name="SettingsCaption" Text="{x:Static local:Loc.Settings}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <ListBox x:Name="Nav" ItemTemplate="{StaticResource NavItem}" ItemContainerStyle="{StaticResource NavItemStyle}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Nav_SelectionChanged" />
        </DockPanel>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" Padding="24,16,28,24" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1000" HorizontalAlignment="Stretch">
                <!-- ===== Features ===== -->
                <StackPanel x:Name="FeaturesPage">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.Features}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.FeaturesSubtitle}" />

                    <!-- App card -->
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Assets/app.ico" Width="72" Height="72" Margin="0,0,20,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:Loc.AppName}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock FontSize="14" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Static local:Loc.VersionLabel}" />
                                    <Run Text="{x:Static local:AppInfo.Version}" />
                                </TextBlock>
                                <TextBlock FontSize="13" Margin="0,2,0,0" Text="{x:Static local:Loc.AuthorLine}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Folders -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Folders}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE713;" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.SettingsFolderLabel}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource PathBox}" ToolTip="{x:Static local:AppInfo.SettingsFolder}">
                                <TextBlock Text="{x:Static local:AppInfo.SettingsFolder}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,6" Click="CopySettingsFolder_Click"
                                    ToolTip="{x:Static local:Loc.CopyPath}" AutomationProperties.Name="{x:Static local:Loc.CopyPath}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                            </Button>
                            <Button Grid.Column="4" Margin="8,0,0,0" Content="{x:Static local:Loc.OpenFolder}" Click="OpenSettingsFolder_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8B7;" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.ProgramFolderLabel}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource PathBox}" ToolTip="{x:Static local:AppInfo.ProgramFolder}">
                                <TextBlock Text="{x:Static local:AppInfo.ProgramFolder}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="3" Margin="8,0,0,0" Padding="9,6" Click="CopyProgramFolder_Click"
                                    ToolTip="{x:Static local:Loc.CopyPath}" AutomationProperties.Name="{x:Static local:Loc.CopyPath}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" />
                            </Button>
                            <Button Grid.Column="4" Margin="8,0,0,0" Content="{x:Static local:Loc.OpenFolder}" Click="OpenProgramFolder_Click" />
                        </Grid>
                    </Border>

                    <!-- Options -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Options}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE8BD;" />
                            </Border>
                            <CheckBox x:Name="TooltipSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static local:Loc.OptTooltipTitle}" Click="TooltipSwitch_Click" />
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptTooltipTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptTooltipDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE7E8;" />
                            </Border>
                            <CheckBox x:Name="AutostartSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static local:Loc.OptAutostartTitle}" Click="AutostartSwitch_Click" />
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptAutostartTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptAutostartDesc}" />
                                <TextBlock x:Name="AutostartError" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource TileGlyph}" Text="&#xEA8F;" />
                            </Border>
                            <CheckBox x:Name="NotifySwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static local:Loc.OptNotifyTitle}" Click="NotifySwitch_Click" />
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptNotifyTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptNotifyDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}">
                                    <TextBlock Style="{StaticResource TileGlyph}" Text="&#xE774;" />
                                </Border>
                                <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="230" VerticalAlignment="Center"
                                          DisplayMemberPath="Label" SelectionChanged="LanguageBox_SelectionChanged"
                                          AutomationProperties.Name="{x:Static local:Loc.OptLanguageTitle}" />
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:Loc.OptLanguageTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" Text="{x:Static local:Loc.OptLanguageDesc}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Notice after a language change: its own row across the full card width (InfoBar style) -->
                            <Border x:Name="RestartHint" Margin="56,12,0,0" Padding="12,8,8,8" CornerRadius="4" Visibility="Collapsed"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Button DockPanel.Dock="Right" Content="{x:Static local:Loc.RestartNow}" Margin="12,0,0,0"
                                            Padding="12,5" VerticalAlignment="Center" Click="Restart_Click"
                                            Style="{DynamicResource AccentButtonStyle}" />
                                    <TextBlock Text="{x:Static local:Loc.RestartNeeded}" FontSize="13" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Help ===== -->
                <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.Help}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.HelpSubtitle}" />
                    <ItemsControl x:Name="HelpList" ItemTemplate="{StaticResource TopicExpander}" />
                </StackPanel>

                <!-- ===== Licenses & privacy ===== -->
                <StackPanel x:Name="LicensePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.LicensesNav}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.LicensesSubtitle}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="{x:Static local:Loc.Licenses}" />
                    <ItemsControl x:Name="LicenseList" ItemTemplate="{StaticResource LicenseExpander}" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.Privacy}" />
                    <ContentControl x:Name="PrivacyBox" ContentTemplate="{StaticResource TopicExpander}" Focusable="False" />
                </StackPanel>

                <!-- ===== Support ===== -->
                <StackPanel x:Name="SupportPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static local:Loc.Support}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{x:Static local:Loc.SupportSubtitle}" />

                    <!-- Main card with animated cup -->
                    <Border Style="{StaticResource Card}" Padding="28,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <local:CoffeeCup Width="128" Height="128" VerticalAlignment="Top" Margin="0,0,32,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:Loc.SupportHeadline}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource BodyText}" Text="{x:Static local:Loc.SupportText}" Margin="0,10,0,18" />
                                <Button Style="{StaticResource KofiButton}" HorizontalAlignment="Left" Click="Kofi_Click"
                                        ToolTip="{x:Static local:AppInfo.KofiUrl}" AutomationProperties.Name="{x:Static local:Loc.BuyCoffee}" />
                                <WrapPanel Margin="0,16,0,0">
                                    <TextBlock Text="{x:Static local:Loc.SupportVoluntary}" FontSize="12" Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="{x:Static local:AppInfo.KofiLabel}" FontSize="12"
                                            Click="Kofi_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Other ways -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static local:Loc.MoreWays}" />
                    <UniformGrid Columns="3" Margin="-2,0,-2,0">
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xE72D;" FontSize="20" Margin="0,0,0,12" />
                                <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.ShareTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.ShareText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <DockPanel>
                                <Button x:Name="GitHubLink" DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Content="{x:Static local:Loc.StarLink}" Click="GitHub_Click" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xE734;" FontSize="20" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.StarTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.StarText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="2,0,2,4" Padding="18,16">
                            <DockPanel>
                                <Button x:Name="IssueLink" DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Content="{x:Static local:Loc.FeedbackLink}" Click="Issue_Click" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TileGlyph}" HorizontalAlignment="Left" Text="&#xED15;" FontSize="20" Margin="0,0,0,12" />
                                    <TextBlock Style="{StaticResource CardTitle}" FontWeight="SemiBold" Text="{x:Static local:Loc.FeedbackTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0" Text="{x:Static local:Loc.FeedbackText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
